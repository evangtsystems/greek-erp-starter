generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationRole {
  OWNER
  ADMIN
  CASHIER
  ACCOUNTANT
  VIEWER
}

enum CustomerType {
  BUSINESS
  INDIVIDUAL
}

enum InvoiceStatus {
  DRAFT
  READY
  SUBMITTING
  ISSUED
  FAILED
  CANCELLED
  CREDITED
}

enum TransmissionStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  UNKNOWN
}

enum ProviderEnvironment {
  SANDBOX
  PRODUCTION
}

enum PaymentMethodType {
  CASH
  CARD
  BANK_TRANSFER
  IRIS
  OTHER
}

enum SerialStatus {
  AVAILABLE
  RESERVED
  SOLD
  RETURNED
  IN_REPAIR
}

enum StockMovementType {
  INITIAL
  RECEIPT
  SALE
  ADJUSTMENT
  RETURN
}

enum PaymentType {
  CUSTOMER_RECEIPT
  SUPPLIER_PAYMENT
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  CONVERTED
  EXPIRED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  COMPLETED
  INVOICED
  CANCELLED
}

model Organization {
  id           String   @id @default(uuid())
  name         String
  vatNumber    String?  @map("vat_number")
  taxOffice    String?  @map("tax_office")
  address      String?
  city         String?
  postalCode   String?  @map("postal_code")
  country      String   @default("GR")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  members      OrganizationUser[]
  customers    Customer[]
  suppliers    Supplier[]
  products     Product[]
  productFamilies ProductFamily[]
  productCategories ProductCategory[]
  warehouses   Warehouse[]
  stockSerials StockSerial[]
  stockMovements StockMovement[]
  invoiceSeries InvoiceSeries[]
  invoices     Invoice[]
  purchases    PurchaseInvoice[]
  payments     Payment[]
  quotes       Quote[]
  salesOrders  SalesOrder[]
  providerCredentials ProviderCredential[]
  transmissions ProviderTransmission[]
  auditLogs    AuditLog[]

  @@map("organizations")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organizations OrganizationUser[]

  @@map("users")
}

model OrganizationUser {
  organizationId String           @map("organization_id")
  userId         String           @map("user_id")
  role           OrganizationRole @default(VIEWER)
  createdAt      DateTime         @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([organizationId, userId])
  @@map("organization_users")
}

model Customer {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  externalCode   String?      @map("external_code")
  type           CustomerType @default(BUSINESS)
  name           String
  vatNumber      String?      @map("vat_number")
  taxOffice      String?      @map("tax_office")
  email          String?
  phone          String?
  address        String?
  city           String?
  postalCode     String?      @map("postal_code")
  country        String       @default("GR")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoices     Invoice[]
  payments     Payment[]
  quotes       Quote[]
  salesOrders  SalesOrder[]

  @@unique([organizationId, externalCode])
  @@index([organizationId])
  @@index([organizationId, vatNumber])
  @@map("customers")
}

model Supplier {
  id             String            @id @default(uuid())
  organizationId String            @map("organization_id")
  name           String
  vatNumber      String?           @map("vat_number")
  taxOffice      String?           @map("tax_office")
  email          String?
  phone          String?
  address        String?
  city           String?
  postalCode     String?           @map("postal_code")
  country        String            @default("GR")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchases      PurchaseInvoice[]
  payments       Payment[]

  @@index([organizationId])
  @@index([organizationId, vatNumber])
  @@map("suppliers")
}

model ProductFamily {
  id String @id @default(uuid())
  organizationId String @map("organization_id")
  name String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  categories ProductCategory[]
  @@unique([organizationId, name])
  @@map("product_families")
}

model ProductCategory {
  id String @id @default(uuid())
  organizationId String @map("organization_id")
  familyId String @map("family_id")
  name String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  family ProductFamily @relation(fields: [familyId], references: [id], onDelete: Cascade)
  products Product[]
  @@unique([familyId, name])
  @@index([organizationId])
  @@map("product_categories")
}

model Product {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  categoryId String? @map("category_id")
  code           String?
  name           String
  description    String?
  unit           String   @default("piece")
  unitPrice      Decimal  @db.Decimal(15, 4) @map("unit_price")
  vatRate        Decimal  @db.Decimal(5, 2) @map("vat_rate")
  classificationType String? @map("classification_type")
  classificationCategory String? @map("classification_category")
  active         Boolean  @default(true)
  trackSerialNumbers Boolean @default(false) @map("track_serial_numbers")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  serials StockSerial[]
  stockMovements StockMovement[]
  invoiceLines InvoiceLine[]
  purchaseLines PurchaseInvoiceLine[]
  quoteLines QuoteLine[]
  orderLines SalesOrderLine[]

  @@unique([organizationId, code])
  @@index([categoryId])
  @@index([organizationId])
  @@map("products")
}

model Warehouse {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  code           String
  name           String
  address        String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stockSerials   StockSerial[]
  stockMovements StockMovement[]

  @@unique([organizationId, code])
  @@index([organizationId, active])
  @@map("warehouses")
}

model StockSerial {
  id String @id @default(uuid())
  organizationId String @map("organization_id")
  productId String @map("product_id")
  warehouseId String @map("warehouse_id")
  serialNumber String @map("serial_number")
  status SerialStatus @default(AVAILABLE)
  notes String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  movements StockMovement[]
  @@unique([organizationId, serialNumber])
  @@index([productId, status])
  @@index([warehouseId, status])
  @@map("stock_serials")
}

model StockMovement {
  id             String            @id @default(uuid())
  organizationId String            @map("organization_id")
  productId      String            @map("product_id")
  warehouseId    String            @map("warehouse_id")
  serialId       String?           @map("serial_id")
  type           StockMovementType
  quantity       Decimal           @db.Decimal(15, 4)
  unitCost       Decimal?          @db.Decimal(15, 4) @map("unit_cost")
  reference      String?
  notes          String?
  createdAt      DateTime          @default(now()) @map("created_at")

  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product        Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse      Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  serial         StockSerial?      @relation(fields: [serialId], references: [id], onDelete: SetNull)

  @@index([organizationId, productId])
  @@index([warehouseId, productId])
  @@index([serialId])
  @@index([organizationId, createdAt])
  @@map("stock_movements")
}

model InvoiceSeries {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  code           String
  documentType   String   @map("document_type")
  nextNumber     Int      @default(1) @map("next_number")
  active         Boolean  @default(true)
  providerBillingBookId String? @map("provider_billing_book_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoices      Invoice[]

  @@unique([organizationId, code, documentType])
  @@map("invoice_series")
}

model Invoice {
  id                 String        @id @default(uuid())
  organizationId     String        @map("organization_id")
  customerId         String?       @map("customer_id")
  seriesId           String        @map("series_id")
  invoiceNumber      Int?          @map("invoice_number")
  documentType       String        @map("document_type")
  issueDate          DateTime?     @map("issue_date")
  status             InvoiceStatus @default(DRAFT)
  currency           String        @default("EUR")
  paymentMethod      PaymentMethodType @default(BANK_TRANSFER) @map("payment_method")
  paymentStatus      String        @default("UNPAID") @map("payment_status")
  netAmount          Decimal       @default(0) @db.Decimal(15, 2) @map("net_amount")
  vatAmount          Decimal       @default(0) @db.Decimal(15, 2) @map("vat_amount")
  totalAmount        Decimal       @default(0) @db.Decimal(15, 2) @map("total_amount")
  providerDocumentId String?       @map("provider_document_id")
  providerStatus     String?       @map("provider_status")
  mydataMark         String?       @map("mydata_mark")
  mydataUid          String?       @map("mydata_uid")
  qrUrl              String?       @map("qr_url")
  issuedAt           DateTime?     @map("issued_at")
  cancelledAt        DateTime?     @map("cancelled_at")
  cancelReason       String?       @map("cancel_reason")
  creditedInvoiceId  String?       @map("credited_invoice_id")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer        Customer?      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  series          InvoiceSeries  @relation(fields: [seriesId], references: [id], onDelete: Restrict)
  creditedInvoice Invoice?       @relation("CreditNoteRelation", fields: [creditedInvoiceId], references: [id], onDelete: SetNull)
  creditNotes     Invoice[]      @relation("CreditNoteRelation")
  lines           InvoiceLine[]
  transmissions   ProviderTransmission[]
  payments        Payment[]
  convertedFromQuote Quote?      @relation("QuoteToInvoice")
  convertedFromOrder SalesOrder? @relation("OrderToInvoice")

  @@unique([organizationId, seriesId, invoiceNumber])
  @@index([organizationId, status])
  @@index([organizationId, issueDate])
  @@index([creditedInvoiceId])
  @@map("invoices")
}

model InvoiceLine {
  id                     String  @id @default(uuid())
  invoiceId              String  @map("invoice_id")
  productId              String? @map("product_id")
  lineNo                 Int     @map("line_no")
  description            String
  quantity               Decimal @db.Decimal(15, 4)
  unitPrice              Decimal @db.Decimal(15, 4) @map("unit_price")
  discountAmount         Decimal @default(0) @db.Decimal(15, 2) @map("discount_amount")
  netValue               Decimal @db.Decimal(15, 2) @map("net_value")
  vatCategory            String? @map("vat_category")
  vatRate                Decimal @db.Decimal(5, 2) @map("vat_rate")
  vatAmount              Decimal @db.Decimal(15, 2) @map("vat_amount")
  classificationType     String? @map("classification_type")
  classificationCategory String? @map("classification_category")
  totalValue             Decimal @db.Decimal(15, 2) @map("total_value")

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([invoiceId, lineNo])
  @@map("invoice_lines")
}

model PurchaseInvoice {
  id             String                @id @default(uuid())
  organizationId String                @map("organization_id")
  supplierId     String                @map("supplier_id")
  documentNumber String                @map("document_number")
  documentType   String                @default("14.1") @map("document_type")
  issueDate      DateTime              @map("issue_date")
  paymentMethod  PaymentMethodType     @default(BANK_TRANSFER) @map("payment_method")
  paymentStatus  String                @default("PAID") @map("payment_status")
  netAmount      Decimal               @default(0) @db.Decimal(15, 2) @map("net_amount")
  vatAmount      Decimal               @default(0) @db.Decimal(15, 2) @map("vat_amount")
  totalAmount    Decimal               @default(0) @db.Decimal(15, 2) @map("total_amount")
  notes          String?
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  supplier       Supplier              @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  lines          PurchaseInvoiceLine[]
  payments       Payment[]

  @@unique([organizationId, supplierId, documentNumber])
  @@index([organizationId, issueDate])
  @@map("purchase_invoices")
}

model PurchaseInvoiceLine {
  id             String          @id @default(uuid())
  purchaseId     String          @map("purchase_id")
  productId      String?         @map("product_id")
  lineNo         Int             @map("line_no")
  description    String
  quantity       Decimal         @db.Decimal(15, 4)
  unitPrice      Decimal         @db.Decimal(15, 4) @map("unit_price")
  netValue       Decimal         @db.Decimal(15, 2) @map("net_value")
  vatRate        Decimal         @db.Decimal(5, 2) @map("vat_rate")
  vatAmount      Decimal         @db.Decimal(15, 2) @map("vat_amount")
  totalValue     Decimal         @db.Decimal(15, 2) @map("total_value")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  purchase       PurchaseInvoice @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product        Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([purchaseId, lineNo])
  @@map("purchase_invoice_lines")
}

model ProviderTransmission {
  id             String             @id @default(uuid())
  organizationId String             @map("organization_id")
  invoiceId      String             @map("invoice_id")
  provider       String
  requestId      String?            @map("request_id")
  idempotencyKey String             @map("idempotency_key")
  operation      String
  status         TransmissionStatus @default(PENDING)
  requestPayload Json?              @map("request_payload")
  responsePayload Json?             @map("response_payload")
  errorCode      String?            @map("error_code")
  errorMessage   String?            @map("error_message")
  attempt        Int                @default(1)
  createdAt      DateTime           @default(now()) @map("created_at")
  completedAt    DateTime?          @map("completed_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@unique([idempotencyKey, attempt])
  @@index([invoiceId])
  @@map("provider_transmissions")
}

model ProviderCredential {
  id             String              @id @default(uuid())
  organizationId String              @map("organization_id")
  provider       String
  environment    ProviderEnvironment @default(SANDBOX)
  enabled        Boolean             @default(true)
  credentials    Json                @default("{}")
  metadata       Json?               @map("metadata")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider, environment])
  @@index([organizationId, enabled])
  @@map("provider_credentials")
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  userId         String?  @map("user_id")
  entityType     String   @map("entity_type")
  entityId       String   @map("entity_id")
  action         String
  previousData   Json?    @map("previous_data")
  newData        Json?    @map("new_data")
  ip             String?
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, entityType, entityId])
  @@map("audit_logs")
}

model Payment {
  id                String            @id @default(uuid())
  organizationId    String            @map("organization_id")
  type              PaymentType
  customerId        String?           @map("customer_id")
  supplierId        String?           @map("supplier_id")
  invoiceId         String?           @map("invoice_id")
  purchaseInvoiceId String?           @map("purchase_invoice_id")
  amount            Decimal           @db.Decimal(15, 2)
  paymentMethod     PaymentMethodType @default(BANK_TRANSFER) @map("payment_method")
  paymentDate       DateTime          @default(now()) @map("payment_date")
  reference         String?
  notes             String?
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer          Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  supplier          Supplier?         @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  invoice           Invoice?          @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  purchaseInvoice   PurchaseInvoice?  @relation(fields: [purchaseInvoiceId], references: [id], onDelete: SetNull)

  @@index([organizationId, type])
  @@index([organizationId, customerId])
  @@index([organizationId, supplierId])
  @@index([organizationId, paymentDate])
  @@map("payments")
}

model Quote {
  id                 String       @id @default(uuid())
  organizationId     String       @map("organization_id")
  customerId         String?      @map("customer_id")
  quoteNumber        String       @map("quote_number")
  status             QuoteStatus  @default(DRAFT)
  issueDate          DateTime     @default(now()) @map("issue_date")
  validUntil         DateTime?    @map("valid_until")
  netAmount          Decimal      @default(0) @db.Decimal(15, 2) @map("net_amount")
  vatAmount          Decimal      @default(0) @db.Decimal(15, 2) @map("vat_amount")
  totalAmount        Decimal      @default(0) @db.Decimal(15, 2) @map("total_amount")
  notes              String?
  convertedInvoiceId String?      @unique @map("converted_invoice_id")
  convertedOrderId   String?      @unique @map("converted_order_id")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer           Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  convertedInvoice   Invoice?     @relation("QuoteToInvoice", fields: [convertedInvoiceId], references: [id], onDelete: SetNull)
  convertedOrder     SalesOrder?  @relation("QuoteToOrder", fields: [convertedOrderId], references: [id], onDelete: SetNull)
  lines              QuoteLine[]

  @@unique([organizationId, quoteNumber])
  @@index([organizationId, status])
  @@map("quotes")
}

model QuoteLine {
  id          String   @id @default(uuid())
  quoteId     String   @map("quote_id")
  productId   String?  @map("product_id")
  lineNo      Int      @map("line_no")
  description String
  quantity    Decimal  @db.Decimal(15, 4)
  unitPrice   Decimal  @db.Decimal(15, 4) @map("unit_price")
  netValue    Decimal  @db.Decimal(15, 2) @map("net_value")
  vatRate     Decimal  @db.Decimal(5, 2) @map("vat_rate")
  vatAmount   Decimal  @db.Decimal(15, 2) @map("vat_amount")
  totalValue  Decimal  @db.Decimal(15, 2) @map("total_value")

  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([quoteId, lineNo])
  @@map("quote_lines")
}

model SalesOrder {
  id                   String           @id @default(uuid())
  organizationId       String           @map("organization_id")
  customerId           String?          @map("customer_id")
  orderNumber          String           @map("order_number")
  status               OrderStatus      @default(PENDING)
  orderDate            DateTime         @default(now()) @map("order_date")
  expectedDeliveryDate DateTime?        @map("expected_delivery_date")
  netAmount            Decimal          @default(0) @db.Decimal(15, 2) @map("net_amount")
  vatAmount            Decimal          @default(0) @db.Decimal(15, 2) @map("vat_amount")
  totalAmount          Decimal          @default(0) @db.Decimal(15, 2) @map("total_amount")
  notes                String?
  invoicedInvoiceId    String?          @unique @map("invoiced_invoice_id")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  organization         Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer             Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  invoicedInvoice      Invoice?         @relation("OrderToInvoice", fields: [invoicedInvoiceId], references: [id], onDelete: SetNull)
  sourceQuote          Quote?           @relation("QuoteToOrder")
  lines                SalesOrderLine[]

  @@unique([organizationId, orderNumber])
  @@index([organizationId, status])
  @@map("sales_orders")
}

model SalesOrderLine {
  id           String     @id @default(uuid())
  salesOrderId String     @map("sales_order_id")
  productId    String?    @map("product_id")
  lineNo       Int        @map("line_no")
  description  String
  quantity     Decimal    @db.Decimal(15, 4)
  unitPrice    Decimal    @db.Decimal(15, 4) @map("unit_price")
  netValue     Decimal    @db.Decimal(15, 2) @map("net_value")
  vatRate      Decimal    @db.Decimal(5, 2) @map("vat_rate")
  vatAmount    Decimal    @db.Decimal(15, 2) @map("vat_amount")
  totalValue   Decimal    @db.Decimal(15, 2) @map("total_value")

  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product      Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([salesOrderId, lineNo])
  @@map("sales_order_lines")
}
